          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3281d47-4a79-46b9-af84-ca4846abc358",
      "name": "Worth reporting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        -176
