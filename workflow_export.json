    {
      "parameters": {
        "command": "=cat >> ~/telcolab1/ai_log_analysis_report.md << 'EOF'\n\n## {{ $json.output.severity }} - {{ $json.output.component }} - {{ $now.toISO() }}\n**Resumen:** {{ $json.output.event_summary }}\n**Causa raiz probable:** {{ $json.output.probable_root_cause }}\n**Accion recomendada:** {{ $json.output.recommended_action }}\n**Requiere aprobacion humana:** {{ $json.output.requires_human_approval }}\nEOF"
      },
      "id": "7c5ef58d-b7a6-4f91-8417-045f7b472800",
      "name": "Append report (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1792,
        -176
      ]
    },
    {
      "parameters": {
        "authentication": "basicAuth",
        "resource": "incident",
        "operation": "create",
        "short_description": "={{ $json.output.severity }} - {{ $json.output.component }}: {{ $json.output.event_summary.substring(0,80) }}",
        "additionalFields": {
          "cmdb_ci": "={{ $json.output.component === \"AMF\" ? \"19646ac8837e8310235ac2dfeeaad3db\" : $json.output.component === \"MME\" ? \"1315224c837e8310235ac2dfeeaad3b7\" : $json.output.component === \"RAN\" ? \"6535a24c837e8310235ac2dfeeaad3f8\" : \"\" }}",
          "description": "={{ \"Root cause: \" + $json.output.probable_root_cause + \"\\n\\nRecommended action: \" + $json.output.recommended_action + \"\\n\\nEvidencia (S3): s3://open5gs-noc-reports/\" + $json.report_key + \".md\" }}",
          "impact": "={{  $json.output.severity === \"CRITICAL\" ? \"1\" : $json.output.severity === \"WARNING\" ? \"2\" : \"3\"  }}",
          "urgency": "={{  $json.output.severity === \"CRITICAL\" ? \"1\" : $json.output.severity === \"WARNING\" ? \"2\" : \"3\"  }}"
        }
      },
      "type": "n8n-nodes-base.serviceNow",
      "typeVersion": 1,
      "position": [
        1552,
        -176
      ],
      "id": "0e2de59f-0228-49de-9712-cbf446516c03",
      "name": "Create an incident"
    },
    {
      "parameters": {
        "command": "=FILE=/tmp/{{ $json.report_key }}.md; printf '%s\\n' \"## {{ $json.output.severity }} - {{ $json.output.component }} - {{ $now.toISO() }}\" \"\" \"Resumen:\" \"{{ $json.output.event_summary }}\" \"\" \"Causa probable:\" \"{{ $json.output.probable_root_cause }}\" \"\" \"Accion recomendada:\" \"{{ $json.output.recommended_action }}\" > \"$FILE\"; AWS_ENDPOINT_URL=http://192.168.0.17:4566 AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=us-east-1 aws s3 cp \"$FILE\" s3://open5gs-noc-reports/{{ $json.report_key }}.md"
      },
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1344,
        32
      ],
      "id": "f40785fa-c71c-47d1-a64c-3570740f81cb",
