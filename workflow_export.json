      "id": "8b2d2af6-ea81-4485-bb30-794882abcb14",
      "name": "Merge 3 sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        144,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combina los 3 logs etiquetados en un solo bloque de texto\n// y hace una pre-detección barata de anomalías por regex\n// antes de gastar tokens en el agente de IA.\nconst items = $input.all();\nlet combined = '';\nfor (const item of items) {\n  combined += `\\n=== [${item.json.component}] ===\\n${item.json.raw}\\n`;\n}\n\nconst anomalyPattern = /(WARNING|ERROR|FATAL|Could not resolve|refused|failed|Failed|timer expired|CRITICAL)/i;\nconst hasAnomaly = anomalyPattern.test(combined);\n\nreturn [{ json: { combinedLogs: combined, hasAnomaly, checkedAt: new Date().toISOString() } }];"
      },
      "id": "611f4e0b-0233-4e80-ada9-b371239cabc3",
      "name": "Combine + pre-filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.hasAnomaly }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1230612-afae-4e56-ab16-ac11edf173a1",
      "name": "Anomaly detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        576,
        -80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.combinedLogs }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Eres un ingeniero senior de NOC/SRE especializado en Core telecom 4G/5G (Open5GS) y RAN (srsRAN/LTE). Recibes logs crudos etiquetados por componente (AMF, MME, RAN-eNB). Tu trabajo:\n1. Identifica cualquier anomalía real (no confundas logs INFO normales de procedimientos 3GPP -Attach, Detach, RACH, timers de idle- con fallas).\n2. Si encuentras un WARNING/ERROR, usa la herramienta lookup_3gpp_pattern para contrastarlo contra patrones conocidos antes de concluir.\n3. Clasifica severidad: INFO, WARNING o CRITICAL.\n4. Da una causa raíz probable en términos de procedimiento 3GPP / arquitectura NFV (ej. resolución DNS de un NF vecino, flap de conexión S1AP, fallo de autenticación, etc).\n5. Recomienda una acción concreta y marca si requiere aprobación humana antes de ejecutarse (nunca recomiendes ejecutar cambios tú mismo).\nResponde siempre en el formato estructurado definido."
        }
      },
      "id": "715f0f45-f1bb-4c74-bddf-dd63166cf448",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        848,
        -176
      ]
    },
