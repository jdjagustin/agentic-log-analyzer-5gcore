    {
      "parameters": {
        "name": "lookup_3gpp_pattern",
        "description": "Devuelve la explicación canónica de un patrón de log conocido en Open5GS/srsRAN dado un fragmento de texto de búsqueda (ej. 'Could not resolve host', 'connection refused', 'Mobile Reachable timer').",
        "jsCode": "const patterns = {\n  'could not resolve host': 'Fallo de resolucion DNS interno de Kubernetes hacia otro Network Function (tipicamente SCP o NRF). Comun durante el arranque si el pod dependiente aun no esta Ready. Se autorresuelve por reintento con backoff.',\n  'connection refused': 'El peer (eNB u otro NF) cerro o aun no acepta conexiones SCTP/HTTP2 -- normalmente por reinicio/redeploy del pod remoto.',\n  'mobile reachable timer expired': 'Procedimiento normal 3GPP: el UE quedo idle mas alla del temporizador configurado, el MME inicia detach implicito. No es una falla.',\n  'attach request': 'Procedimiento normal 3GPP de registro de UE en la red (Attach). No es una falla.',\n  'rach': 'Random Access Channel exitoso entre UE y eNodeB. Comportamiento esperado.'\n};\nconst q = (query || '').toLowerCase();\nfor (const key of Object.keys(patterns)) {\n  if (q.includes(key)) return patterns[key];\n}\nreturn 'Patron no encontrado en la base de conocimiento local; usa tu propio criterio experto.';"
      },
      "id": "f0e5920d-ba54-4a9d-b4d3-96ca8614c46f",
      "name": "lookup_3gpp_pattern",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        960,
        32
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"severity\": { \"type\": \"string\", \"enum\": [\"INFO\", \"WARNING\", \"CRITICAL\"] },\n    \"component\": { \"type\": \"string\" },\n    \"event_summary\": { \"type\": \"string\" },\n    \"probable_root_cause\": { \"type\": \"string\" },\n    \"recommended_action\": { \"type\": \"string\" },\n    \"requires_human_approval\": { \"type\": \"boolean\" }\n  },\n  \"required\": [\"severity\", \"component\", \"event_summary\", \"probable_root_cause\", \"recommended_action\", \"requires_human_approval\"]\n}"
      },
      "id": "291865aa-e90b-47fe-9687-f0753d0db39c",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1168,
        32
